<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/training_letter/db" VERSION="20261029" COMMENT="XMLDB file">
  <TABLES>
    <TABLE NAME="local_training_letter" COMMENT="Stores training requests">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="userid" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="fullname" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="rollno" TYPE="char" LENGTH="50" NOTNULL="true"/>
        <FIELD NAME="branch" TYPE="char" LENGTH="100" NOTNULL="true"/>
        <FIELD NAME="semester" TYPE="char" LENGTH="20" NOTNULL="true"/>
        <FIELD NAME="orgname" TYPE="char" LENGTH="255" NOTNULL="true"/>
        <FIELD NAME="orgaddress" TYPE="text" NOTNULL="true"/>
        <FIELD NAME="trainingtype" TYPE="char" LENGTH="50" NOTNULL="true"/>
        <FIELD NAME="duration" TYPE="char" LENGTH="50" NOTNULL="true"/>
        <FIELD NAME="joiningdate" TYPE="int" LENGTH="10" NOTNULL="true"/>
        <FIELD NAME="status" TYPE="char" LENGTH="20" DEFAULT="pending" NOTNULL="true"/>
        <FIELD NAME="remarks" TYPE="text" NOTNULL="false"/>
        <FIELD NAME="timecreated" TYPE="int" LENGTH="10" NOTNULL="true"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>